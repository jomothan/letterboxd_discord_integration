# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id

# TMDB (The Movie Database) - free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# Letterboxd credentials (stored per-user in production; use env for single-user setup)
# For multi-user bots, store these encrypted in a database per Discord user ID
LETTERBOXD_USERNAME=your_letterboxd_username
LETTERBOXD_PASSWORD=your_letterboxd_password
